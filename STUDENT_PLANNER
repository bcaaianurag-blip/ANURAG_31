<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Productivity Planner</title>

    <!-- Bootstrap 5 & Google Fonts -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --glass-bg: rgba(255, 255, 255, 0.95);
        }

        body {
            background: #f0f2f5;
            background-image: radial-gradient(#444cf7 0.5px, #f0f2f5 0.5px);
            background-size: 20px 20px;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            color: #2d3436;
        }

        header {
            background: var(--primary-gradient);
            color: white;
            padding: 40px 20px;
            text-align: center;
            border-bottom-left-radius: 30px;
            border-bottom-right-radius: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 30px;
        }

        .card {
            border: none;
            border-radius: 20px;
            transition: transform 0.3s ease;
            background: var(--glass-bg);
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .task-list {
            list-style: none;
            padding: 0;
            max-height: 300px;
            overflow-y: auto;
        }

        .task-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px;
            border-bottom: 1px solid #eee;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .task-content {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-grow: 1;
        }

        .completed-text {
            text-decoration: line-through;
            color: #a0a0a0;
        }

        .progress {
            height: 12px;
            border-radius: 10px;
            background-color: #e9ecef;
        }

        .btn-add {
            border-radius: 10px;
            font-weight: 600;
        }

        .delete-btn {
            color: #ff7675;
            cursor: pointer;
            transition: 0.2s;
            border: none;
            background: none;
        }

        .delete-btn:hover {
            color: #d63031;
            transform: scale(1.2);
        }

        footer {
            margin-top: 50px;
            padding: 20px;
            color: #636e72;
            text-align: center;
            font-size: 0.9rem;
        }
    </style>
</head>

<body>

<header>
    <h1 class="fw-bold">Student Success Planner</h1>
    <p id="currentDate" class="opacity-75"></p>
</header>

<div class="container">
    <div class="row g-4">
        <!-- Daily Tasks -->
        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-calendar-day text-success me-2"></i>Daily Tasks</h5>
                <div class="input-group mb-3">
                    <input id="dailyInput" class="form-control" placeholder="Study math..." onkeypress="handleEnter(event, 'dailyInput', 'dailyList')">
                    <button class="btn btn-success btn-add" onclick="addTask('dailyInput','dailyList')"><i class="fa-solid fa-plus"></i></button>
                </div>
                <ul id="dailyList" class="task-list"></ul>
            </div>
        </div>

        <!-- Monthly Goals -->
        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-calendar-check text-primary me-2"></i>Monthly Goals</h5>
                <div class="input-group mb-3">
                    <input id="monthlyInput" class="form-control" placeholder="Finish project..." onkeypress="handleEnter(event, 'monthlyInput', 'monthlyList')">
                    <button class="btn btn-primary btn-add" onclick="addTask('monthlyInput','monthlyList')"><i class="fa-solid fa-plus"></i></button>
                </div>
                <ul id="monthlyList" class="task-list"></ul>
            </div>
        </div>

        <!-- Yearly Targets -->
        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-trophy text-warning me-2"></i>Yearly Targets</h5>
                <div class="input-group mb-3">
                    <input id="yearlyInput" class="form-control" placeholder="Get 4.0 GPA..." onkeypress="handleEnter(event, 'yearlyInput', 'yearlyList')">
                    <button class="btn btn-warning btn-add" onclick="addTask('yearlyInput','yearlyList')"><i class="fa-solid fa-plus"></i></button>
                </div>
                <ul id="yearlyList" class="task-list"></ul>
            </div>
        </div>
    </div>

    <!-- Progress Dashboard -->
    <div class="card shadow-sm p-4 mt-5 mb-5">
        <div class="d-flex justify-content-between align-items-end mb-2">
            <h5 class="fw-bold m-0">Overall Productivity</h5>
            <span id="progressText" class="badge bg-dark">Completed 0 of 0 tasks</span>
        </div>
        <div class="progress">
            <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" style="width:0%"></div>
        </div>
    </div>
</div>

<footer>
    <p>© <span id="year"></span> Student Productivity Planner • Keep Grinding!</p>
</footer>

<script>
    // Initialize Data
    let tasks = JSON.parse(localStorage.getItem('studentTasks')) || [];

    document.addEventListener('DOMContentLoaded', () => {
        // Set Date
        const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('currentDate').innerText = new Date().toLocaleDateString(undefined, options);
        document.getElementById('year').innerText = new Date().getFullYear();
        
        renderTasks();
    });

    function handleEnter(event, inputId, listId) {
        if (event.key === 'Enter') {
            addTask(inputId, listId);
        }
    }

    function addTask(inputId, listId) {
        let input = document.getElementById(inputId);
        let text = input.value.trim();

        if (text === "") {
            return;
        }

        const newTask = {
            id: Date.now(),
            text: text,
            completed: false,
            category: listId
        };

        tasks.push(newTask);
        saveAndRender();
        input.value = "";
    }

    function toggleTask(id) {
        tasks = tasks.map(t => t.id === id ? {...t, completed: !t.completed} : t);
        saveAndRender();
    }

    function deleteTask(id) {
        tasks = tasks.filter(t => t.id !== id);
        saveAndRender();
    }

    function saveAndRender() {
        localStorage.setItem('studentTasks', JSON.stringify(tasks));
        renderTasks();
    }

    function renderTasks() {
        const lists = {
            dailyList: document.getElementById('dailyList'),
            monthlyList: document.getElementById('monthlyList'),
            yearlyList: document.getElementById('yearlyList')
        };

        // Clear lists
        Object.values(lists).forEach(list => list.innerHTML = '');

        tasks.forEach(task => {
            let li = document.createElement("li");
            li.className = "task-item";
            li.innerHTML = `
                <div class="task-content">
                    <input type="checkbox" class="form-check-input" ${task.completed ? 'checked' : ''} onchange="toggleTask(${task.id})">
                    <span class="${task.completed ? 'completed-text' : ''}">${task.text}</span>
                </div>
                <button class="delete-btn" onclick="deleteTask(${task.id})"><i class="fa-solid fa-trash-can"></i></button>
            `;
            lists[task.category].appendChild(li);
        });

        updateProgress();
    }

    function updateProgress() {
        let total = tasks.length;
        let completed = tasks.filter(t => t.completed).length;
        let percent = total > 0 ? (completed / total) * 100 : 0;

        document.getElementById("progressText").innerText = `Completed ${completed} of ${total} tasks`;
        document.getElementById("progressBar").style.width = percent + "%";
    }
</script>

</body>
</html>
